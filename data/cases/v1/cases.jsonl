{"case_id": "hn-qiyang-2025-4", "source": {"url": "https://www.qy.gov.cn/qy/zrzyh/202505/bca7e8b0bb224430bebd73bb79c7d64f.shtml", "portal": "祁阳市人民政府", "collected_at": "2026-10-31T14:07:30+08:00", "source_sha256": "8159e8f0adc690da102ef3ec11e9d3045f8fe14a610f92f1fa48ea560e44efbf", "source_kind": "decision"}, "region": "祁阳市", "agency": "祁阳市自然资源局", "decision_no": "祁自资罚决〔2025〕4号", "decision_date": "2025-04-25", "party": {"type": "单位", "name": "祁阳市半岛大酒店有限公司", "name_masked": "祁阳市半岛大酒店有限公司"}, "behavior": ["超过批准数量占用土地"], "scope_status": "included", "exclusion_reason": null, "facts": "被处罚人于2024年8月中旬在位于祁阳市观音滩镇团胜村的土地上动工建设酒店主体房的附属房、6个VIP客房、休闲凉棚，在建设过程中未按照批准红线建设，形成批东占西，产生移位情况，2024年11月底建设全部完工。\n经实地测量，被处罚人非法占地总面积为1071㎡（酒店主体房的附属房超过批准用地面积：147.71㎡、6个VIP客房超过批准用地面积：384.7㎡、休闲凉棚非法占地面积：537.69㎡），其中占用观音滩镇团胜村园地（其他园地）1062㎡、草地地（其他草地）9㎡，占用的1071㎡土地符合观音滩镇团胜村村庄规划。", "land_use": [{"type": "园地", "group": "其他土地", "area_m2": 1062.0}, {"type": "草地", "group": "其他土地", "area_m2": 9.0}], "area_m2": 1071.0, "project_nature": "非公益", "violated_articles": [{"law": "中华人民共和国土地管理法", "article_num": 2, "cited_article_num": 2, "version_year": 2019, "article": "第二条", "article_id": "law-land-admin#a0002", "citation": "《中华人民共和国土地管理法》第二条", "resolved": true, "mapped_from_old_version": false, "source": "cited"}, {"law": "中华人民共和国土地管理法", "article_num": 44, "cited_article_num": 44, "version_year": 2019, "article": "第四十四条", "article_id": "law-land-admin#a0044", "citation": "《中华人民共和国土地管理法》第四十四条", "resolved": true, "mapped_from_old_version": false, "source": "cited"}], "penalty_basis_articles": [{"law": "中华人民共和国土地管理法", "article_num": 77, "cited_article_num": 77, "version_year": 2019, "article": "第七十七条", "article_id": "law-land-admin#a0077", "citation": "《中华人民共和国土地管理法》第七十七条", "resolved": true, "mapped_from_old_version": false, "source": "cited"}, {"law": "中华人民共和国土地管理法实施条例", "article_num": 57, "cited_article_num": 57, "version_year": 2021, "article": "第五十七条", "article_id": "reg-land-admin#a0057", "citation": "《中华人民共和国土地管理法实施条例》第五十